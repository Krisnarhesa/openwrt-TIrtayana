#!/bin/sh
# =============================================================
# TIrtayana: Set root password and finalize system identity
# =============================================================

# ── Set root password ─────────────────────────────────────────
# Use shadow file approach — more reliable than chpasswd in musl
SHADOW_HASH='$6$rW84CFhglzBujiVe$rp9Z49kiBC9M.QC66kEy/4EIX1S7GwOlBSsvgQ545glItXMlllxlpMeXVonxWVU46sFTT/TJI4cAnCNUViq8p.'
sed -i "s|^root:[^:]*:|root:${SHADOW_HASH}:|" /etc/shadow

# ── Safety net: re-apply hostname in case 98- script didn't run ─
HOSTNAME="TIrtayana"
uci -q set system.@system[0].hostname="${HOSTNAME}" 2>/dev/null || true
uci -q commit system 2>/dev/null || true
echo "${HOSTNAME}" > /proc/sys/kernel/hostname 2>/dev/null || true

exit 0
