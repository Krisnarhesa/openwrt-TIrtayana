# =====================================================
# TIrtayana OpenWrt — Minimal Edition (.config.minimal)
# Base system + Network only (NO LuCI)
# Note: kmod-* packages are omitted because ophub
#       replaces ALL kernel modules with custom kernel.
#       Only userspace packages matter in final image.
# =====================================================

# ── Base System ──────────────────────────────────────
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_procd-seccomp=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libubox=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_libucode=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_jshn=y
CONFIG_PACKAGE_libjson-c=y
CONFIG_PACKAGE_libjson-script=y
CONFIG_PACKAGE_libblobmsg-json=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_usign=y
CONFIG_PACKAGE_openwrt-keyring=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_getrandom=y
CONFIG_PACKAGE_ca-bundle=y

# ── Network ──────────────────────────────────────────
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uclient-fetch=y

# ── Libraries ────────────────────────────────────────
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_libnl-tiny=y
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_libuclient=y
CONFIG_PACKAGE_libudebug=y
CONFIG_PACKAGE_jansson=y
CONFIG_PACKAGE_zlib=y

# ── Ophub Runtime Dependencies ──────────────────────
# Ophub injects scripts (30-sysinfo.sh, cpustat) that
# require bash and perl. Without these → errors on login.
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_perl=y
CONFIG_PACKAGE_perlbase-file=y

# ── Disk/Filesystem (required for amlogic eMMC) ─────
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_fwtool=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_libblkid=y
CONFIG_PACKAGE_libuuid=y
CONFIG_PACKAGE_libsmartcols=y
CONFIG_PACKAGE_partx-utils=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_libcomerr=y
CONFIG_PACKAGE_libe2p=y
CONFIG_PACKAGE_libext2fs=y
CONFIG_PACKAGE_libss=y
CONFIG_PACKAGE_libf2fs=y
CONFIG_PACKAGE_mkf2fs=y

# ── Boot (armsr/armv8) ──────────────────────────────
CONFIG_PACKAGE_grub2-efi-arm=y
CONFIG_PACKAGE_u-boot-qemu_armv8=y

# ── TIrtayana Firmware Branding ──
CONFIG_VERSION_DIST="TIrtayana-Minimal"
CONFIG_VERSION_NUMBER="24.10"
CONFIG_VERSION_CODE=""
CONFIG_VERSION_REPO="https://github.com/Krisnarhesa/openwrt-TIrtayana"
CONFIG_VERSION_MANUFACTURER="Universitas Udayana"
CONFIG_VERSION_MANUFACTURER_URL="https://github.com/Krisnarhesa"
CONFIG_VERSION_PRODUCT="STB B860H"
CONFIG_VERSION_HWREV="S905X"
