#!/bin/sh
# =============================================================
# TIrtayana: First-boot initialization
# 1. Restore custom banner (ophub overwrites it)
# 2. Fix cpustat Perl modules missing in OpenWrt musl builds
# 3. Apply hostname from UCI system config
# =============================================================

# ── 1. Restore TIrtayana banner ───────────────────────────────
cat > /etc/banner << 'BANNER'
████████╗██╗██████╗ ████████╗ █████╗ ██╗   ██╗ █████╗ ███╗   ██╗ █████╗
