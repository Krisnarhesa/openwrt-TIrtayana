-#}

{%
	import { getuid, getspnam } from 'luci.core';
	const boardinfo = ubus.call('system', 'board');
	
	// Detect Tirtayana version from release info
	let tirtayanaVersion = "Unknown";
	let versionType = "standard";
	
	if (boardinfo.release?.description) {
		const desc = boardinfo.release.description;
		if (match(desc, /minimal/i)) {
			tirtayanaVersion = "Minimal";
			versionType = "minimal";
		} else if (match(desc, /edukasi/i)) {
			tirtayanaVersion = "Edukasi";
			versionType = "edukasi";
		} else if (match(desc, /standard/i)) {
			tirtayanaVersion = "Standard";
			versionType = "standard";
		} else if (match(desc, /tirtayana/i)) {
			tirtayanaVersion = "Standard";
			versionType = "standard";
		}
	}
	
	// Check for default password warning
	const hasDefaultPassword = (getuid() == 0 && getspnam('root')?.pwdp === '');
	
	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
	<meta charset="utf-8">
	<title>{{ striptags(boardinfo.hostname ?? 'Tirtayana') }} - Login</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="format-detection" content="telephone=no, email=no"/>
	<link rel="stylesheet" href="{{ media }}/cascade.css">
	<link rel="stylesheet" href="{{ media }}/login.css">
	<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
	<script src="{{ resource }}/cbi.js"></script>
</head>

<body class="login-page" data-version-type="{{ versionType }}">
	<div class="login-container">
		<!-- Logo and Branding -->
		<div class="login-header">
			<div class="login-logo">
				<img src="{{ media }}/logo.svg" alt="Tirtayana Logo" />
			</div>
			<h1 class="login-title">Tirtayana OpenWrt</h1>
			<p class="login-subtitle">{{ striptags(boardinfo.hostname ?? 'Router') }}</p>
		</div>

		<!-- Version Information -->
		<div class="version-info-cards">
			<div class="version-card {{ versionType == 'minimal' ? 'active' : '' }}">
				<div class="version-icon">🔹</div>
				<div class="version-name">Minimal</div>
				<div class="version-desc">Essential features only</div>
			</div>
			<div class="version-card {{ versionType == 'standard' ? 'active' : '' }}">
				<div class="version-icon">⭐</div>
				<div class="version-name">Standard</div>
				<div class="version-desc">Recommended for most users</div>
			</div>
			<div class="version-card {{ versionType == 'edukasi' ? 'active' : '' }}">
				<div class="version-icon">🎓</div>
				<div class="version-name">Edukasi</div>
				<div class="version-desc">Educational tools included</div>
			</div>
		</div>

		<!-- Current Version Badge -->
		<div class="current-version-badge">
			<span class="badge-label">Current Version:</span>
			<span class="badge-value {{ versionType }}">{{ tirtayanaVersion }}</span>
		</div>

		<!-- Default Password Warning -->
		{% if (hasDefaultPassword): %}
		<div class="alert alert-danger login-alert">
			<div class="alert-icon">⚠️</div>
			<div class="alert-content">
				<h4>{{ _('Default Password Detected!') }}</h4>
				<p>{{ _('For security reasons, please set a new password immediately after login.') }}</p>
			</div>
		</div>
		{% endif %}

		<!-- Login Form -->
		<div class="login-form-container">
			<form method="post" action="{{ pcdata(REQUEST_URI) }}" class="login-form">
				<div class="form-group">
					<label for="luci_username">
						<span class="label-icon">👤</span>
						{{ _('Username') }}
					</label>
					<input 
						type="text" 
						class="form-control" 
						id="luci_username" 
						name="luci_username" 
						value="{{ entityencode(luci_username ?? 'root', true) }}"
						placeholder="Enter username"
						autocomplete="username"
						autofocus
					/>
				</div>

				<div class="form-group">
					<label for="luci_password">
						<span class="label-icon">🔒</span>
						{{ _('Password') }}
					</label>
					<input 
						type="password" 
						class="form-control" 
						id="luci_password" 
						name="luci_password" 
						placeholder="Enter password"
						autocomplete="current-password"
					/>
				</div>

				<div class="form-actions">
					<button type="submit" class="btn btn-primary btn-login">
						<span class="btn-text">{{ _('Login') }}</span>
						<span class="btn-icon">→</span>
					</button>
				</div>

				{% if (fuser): %}
				<input type="hidden" name="luci_username" value="{{ entityencode(fuser, true) }}" />
				{% endif %}
			</form>
		</div>

		<!-- Additional Information -->
		<div class="login-footer">
			<div class="info-grid">
				<div class="info-item">
					<div class="info-icon">📦</div>
					<div class="info-text">
						<div class="info-label">OpenWrt Version</div>
						<div class="info-value">{{ boardinfo.release?.version ?? 'Unknown' }}</div>
					</div>
				</div>
				<div class="info-item">
					<div class="info-icon">💾</div>
					<div class="info-text">
						<div class="info-label">Kernel</div>
						<div class="info-value">{{ boardinfo.kernel ?? 'Unknown' }}</div>
					</div>
				</div>
				<div class="info-item">
					<div class="info-icon">🖥️</div>
					<div class="info-text">
						<div class="info-label">Board</div>
						<div class="info-value">{{ boardinfo.board_name ?? 'Unknown' }}</div>
					</div>
				</div>
			</div>
			
			<div class="copyright">
				<p>&copy; {{ localtime('%Y') }} <strong>Tirtayana</strong> | Powered by OpenWrt</p>
			</div>
		</div>
	</div>

	<script>
		// Auto-focus on password field if username is already filled
		document.addEventListener('DOMContentLoaded', function() {
			const usernameField = document.getElementById('luci_username');
			const passwordField = document.getElementById('luci_password');
			
			if (usernameField && usernameField.value && passwordField) {
				passwordField.focus();
			}
		});

		// Show default password change reminder
		{% if (hasDefaultPassword): %}
		window.addEventListener('load', function() {
			// Store that we need to show password change dialog
			sessionStorage.setItem('tirtayana_show_password_reminder', 'true');
		});
		{% endif %}
	</script>
</body>
</html>
